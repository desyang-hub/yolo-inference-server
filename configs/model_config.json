{
  "name": "yolov8n",
  "model_path": "models/yolov8n.onnx",
  "model_type": "yolo",
  "input": {
    "name": "images",
    "shape": [1, 3, 640, 640],
    "type": "tensor(float)"
  },
  "output": {
    "name": "output0",
    "shape": [1, 84, 8400],
    "type": "tensor(float)"
  },
  "preprocess": {
    "format": "BGR",
    "mean_r": 0.0,
    "mean_g": 0.0,
    "mean_b": 0.0,
    "std_r": 1.0,
    "std_g": 1.0,
    "std_b": 1.0,
    "scale_to_zero_one": true,
    "rgb_conversion": true
  },
  "postprocess": {
    "num_classes": 80,
    "conf_threshold": 0.80,
    "nms_threshold": 0.45,
    "max_detections": 300
  },
  "onnx_runtime": {
    "intra_op_num_threads": 0,
    "inter_op_num_threads": 0,
    "gpu_provider": "none",
    "gpu_device_id": 0,
    "gpu_mem_limit": 0,
    "cudnn_conv_algo_search": 0,
    "cuda_arena_extend_strategy": 0
  }
}
