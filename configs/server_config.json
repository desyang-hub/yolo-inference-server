{
  "server": {
    "host": "0.0.0.0",
    "port": 8080,
    "num_threads": 4
  },
  "logging": {
    "level": "info",
    "file": ""
  },
  "batch": {
    "enabled": true,
    "max_batch_size": 8,
    "timeout_ms": 10,
    "min_batch_size": 1
  },
  "models": [
    {
      "name": "yolov8n",
      "model_path": "models/yolov8n.onnx",
      "model_type": "yolo",
      "input": {
        "name": "images",
        "shape": [1, 3, 640, 640],
        "type": "tensor(float)"
      },
      "preprocess": {
        "format": "BGR",
        "scale_to_zero_one": true,
        "rgb_conversion": true
      },
      "postprocess": {
        "num_classes": 80,
        "conf_threshold": 0.25,
        "nms_threshold": 0.45,
        "max_detections": 300
      }
    }
  ]
}
